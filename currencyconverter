<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Currency Converter Pro</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

<style>
:root {
  --bg-gradient: linear-gradient(135deg, #667eea, #764ba2);
  --card-bg: rgba(255,255,255,0.15);
  --text-color: white;
  --input-bg: rgba(255,255,255,0.2);
}

body.dark {
  --bg-gradient: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
  --card-bg: rgba(0,0,0,0.4);
  --text-color: white;
  --input-bg: rgba(255,255,255,0.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

body {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--bg-gradient);
  color: var(--text-color);
}

.container {
  backdrop-filter: blur(20px);
  background: var(--card-bg);
  padding: 40px;
  border-radius: 25px;
  width: 380px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.3);
}

input {
  width: 100%;
  padding: 12px;
  margin: 5px 0;
  border-radius: 12px;
  border: none;
  outline: none;
  font-size: 15px;
  background: var(--input-bg);
  color: var(--text-color);
}

.dropdown {
  position: relative;
}

.dropdown-list {
  position: absolute;
  width: 100%;
  max-height: 200px;
  overflow-y: auto;
  background: white;
  color: black;
  border-radius: 12px;
  display: none;
  z-index: 100;
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}

/* Search bar inside dropdown */
.dropdown-list .dropdown-search {
  background: #f1f1f1;   /* light background for visibility */
  color: black;           /* black text */
  font-weight: 500;
  margin: 0;
  padding: 10px;
  border-radius: 12px 12px 0 0;
  border: none;
  outline: none;
}

.dropdown-list div {
  padding: 10px;
  cursor: pointer;
  color: black; /* ensure visibility */
}

.dropdown-list div:hover {
  background: #ddd; /* highlight on hover */
}

.result {
  margin-top: 20px;
  font-size: 20px;
  text-align: center;
  font-weight: 500;
  opacity: 0;
  transform: translateY(10px);
  transition: 0.3s;
}

.result.show {
  opacity: 1;
  transform: translateY(0);
}

.toggle {
  position: absolute;
  top: 20px;
  right: 20px;
  cursor: pointer;
  font-size: 14px;
  background: var(--card-bg);
  padding: 8px 14px;
  border-radius: 20px;
}
</style>
</head>

<body>

<div class="toggle" onclick="toggleTheme()">🌙 Toggle</div>

<div class="container">
  <h1>💱 Currency Converter</h1>

  <input type="number" id="amount" placeholder="Enter amount" />

  <!-- From Currency Dropdown -->
  <div class="dropdown">
    <input type="text" id="fromInput" placeholder="From currency" readonly>
    <div class="dropdown-list" id="fromList">
      <input type="text" class="dropdown-search" placeholder="Search...">
    </div>
  </div>

  <!-- To Currency Dropdown -->
  <div class="dropdown">
    <input type="text" id="toInput" placeholder="To currency" readonly>
    <div class="dropdown-list" id="toList">
      <input type="text" class="dropdown-search" placeholder="Search...">
    </div>
  </div>

  <div class="result" id="result"></div>
</div>

<script>
const amountInput = document.getElementById("amount");
const result = document.getElementById("result");

const fromInput = document.getElementById("fromInput");
const toInput = document.getElementById("toInput");
const fromList = document.getElementById("fromList");
const toList = document.getElementById("toList");

const fromSearch = fromList.querySelector(".dropdown-search");
const toSearch = toList.querySelector(".dropdown-search");

const currencyNames = new Intl.DisplayNames(['en'], { type: 'currency' });
let currencies = [];

fetch("https://open.er-api.com/v6/latest/USD")
  .then(res => res.json())
  .then(data => {
    currencies = Object.keys(data.rates).map(code => ({
      code,
      name: currencyNames.of(code) || code
    }));

    populateDropdown(fromList, fromInput, fromSearch);
    populateDropdown(toList, toInput, toSearch);

    fromInput.value = "United States Dollar (USD)";
    toInput.value = "Euro (EUR)";
    convert();
  });

function populateDropdown(list, input, searchInput) {
  list.querySelectorAll('div').forEach(d => d.remove());

  currencies.forEach(c => {
    const div = document.createElement("div");
    div.textContent = `${c.name} (${c.code})`;
    div.onclick = () => {
      input.value = div.textContent;
      list.style.display = "none";
      convert();
    };
    list.appendChild(div);
  });

  // Filter items on typing in search
  searchInput.addEventListener("input", () => {
    const value = searchInput.value.toLowerCase();
    list.querySelectorAll("div").forEach(div => {
      if(div !== searchInput) {
        div.style.display = div.textContent.toLowerCase().includes(value) ? "block" : "none";
      }
    });
  });
}

// Open dropdown on click and focus search bar
function setupDropdown(input, list, searchInput) {
  input.addEventListener("click", () => {
    list.style.display = "block";
    searchInput.value = "";
    searchInput.focus();
    list.querySelectorAll("div").forEach(div => div.style.display = "block");
  });

  document.addEventListener("click", e => {
    if(!input.parentElement.contains(e.target)) {
      list.style.display = "none";
    }
  });
}

setupDropdown(fromInput, fromList, fromSearch);
setupDropdown(toInput, toList, toSearch);

amountInput.addEventListener("input", convert);

function getCode(text) {
  const match = text.match(/\((.*?)\)/);
  return match ? match[1] : null;
}

function convert() {
  const amount = amountInput.value;
  const from = getCode(fromInput.value);
  const to = getCode(toInput.value);

  if (!amount || !from || !to) {
    result.classList.remove("show");
    result.innerText = "";
    return;
  }

  fetch(`https://open.er-api.com/v6/latest/${from}`)
    .then(res => res.json())
    .then(data => {
      const rate = data.rates[to];
      const converted = (amount * rate).toFixed(2);
      result.innerText = `${amount} ${currencyNames.of(from)} = ${converted} ${currencyNames.of(to)}`;
      result.classList.add("show");
    });
}

function toggleTheme() {
  document.body.classList.toggle("dark");
}
</script>

</body>
</html>
